   "source": [
    "import cv2 as cv\n",
    "img=cv.imread(\"high-speed-race-car-illustration-ai-generative-free-photo.jpg\",cv.IMREAD_GRAYSCALE)\n",
    "\n",
    "imgre=cv.resize(img,(400,300))\n",
    "cv.imshow(\"car\",img)\n",
    "cv.imshow(\"resize\",imgre)\n",
    "cv.waitKey(0)\n",
    "cv.destroyAllWindows()\n",
    "\n"
